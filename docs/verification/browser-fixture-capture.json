  "url": "http://127.0.0.1:58236/customers",
  "title": "客户列表",
  "text": "客户列表\n搜索客户搜索新增客户\n青禾科技\n拾光设计\n模拟新增",
  "html": "<html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><title>客户列表</title><style>body{font:16px system-ui;margin:35px;background:#faf9f4}button,input{padding:10px;margin:8px}td{padding:12px;border-bottom:1px solid #ddd}</style></head><body><h1>客户列表</h1><label>搜索客户<input id=\"search\"></label><button id=\"apply\">搜索</button><button id=\"new\">新增客户</button><table><tbody id=\"rows\"><tr><td>青禾科技</td></tr><tr><td>拾光设计</td></tr><tr><td>模拟新增</td></tr></tbody></table><dialog id=\"dialog\"><form id=\"form\"><label>客户名称<input id=\"name\" required=\"\"></label><button>保存</button><button type=\"button\" id=\"cancel\">取消</button></form></dialog><script>const names=['青禾科技','拾光设计'];const render=()=>{document.querySelector('#rows').replaceChildren(...names.filter(n=>n.includes(document.querySelector('#search').value)).map(n=>{const tr=document.createElement('tr');const td=document.createElement('td');td.textContent=n;tr.append(td);return tr;}));};document.querySelector('#apply').onclick=render;document.querySelector('#new').onclick=()=>document.querySelector('#dialog').showModal();document.querySelector('#cancel').onclick=()=>document.querySelector('#dialog').close();document.querySelector('#form').onsubmit=e=>{e.preventDefault();names.push(document.querySelector('#name').value);document.querySelector('#dialog').close();render();};render();</script></body></html>"
}