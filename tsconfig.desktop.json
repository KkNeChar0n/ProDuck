{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "src/desktop",
    "src/contracts",
    "src/projects",
    "src/integrations",
    "src/agent",
    "src/prototypes"
  ]
}
